# AWS Configuration
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-travel-ai-data

# YouTube API Configuration (Optional but Recommended)
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable YouTube Data API v3 in your Google Cloud project
# Free tier: 10,000 quota units/day (1 unit per video metadata fetch)
YOUTUBE_API_KEY=your_youtube_api_key_here

# OpenAI API Configuration (Required for Stage 2)
# Get your API key from: https://platform.openai.com/api-keys
# Used for entity extraction from video transcripts
# Model: gpt-4o-mini (cheaper alternative to GPT-4)
# Cost: ~$0.15 per 1M input tokens, ~$0.60 per 1M output tokens
OPENAI_API_KEY=your_openai_api_key_here

# Application Configuration
LOG_LEVEL=INFO
CRAWLER_RATE_LIMIT=2
MAX_RETRIES=3
