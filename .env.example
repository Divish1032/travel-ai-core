# AWS Configuration
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-travel-ai-data

# YouTube API Configuration (Optional but Recommended)
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable YouTube Data API v3 in your Google Cloud project
# Free tier: 10,000 quota units/day (1 unit per video metadata fetch)
YOUTUBE_API_KEY=your_youtube_api_key_here

# LLM Provider Configuration (Required for Stage 2)
# Choose your LLM provider for entity extraction
LLM_PROVIDER=gemini  # Options: openai, deepseek, gemini

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
# Model: gpt-4o-mini
# Cost: $0.150 per 1M input tokens, $0.600 per 1M output tokens
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek API Configuration (Good balance of cost and quality)
# Get your API key from: https://platform.deepseek.com/api_keys
# Model: deepseek-chat (or deepseek-reasoner for complex tasks)
# Cost: $0.14 per 1M input tokens, $0.28 per 1M output tokens
# Note: DeepSeek is OpenAI-compatible, supports JSON mode
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat  # Options: deepseek-chat, deepseek-reasoner

# Google Gemini API Configuration (Recommended - Free tier available)
# Get your API key from: https://aistudio.google.com/app/apikey
# Model: gemini-2.5-flash-lite (fast & cheap) or gemini-1.5-pro (better quality)
# Cost: Gemini 1.5 Flash - $0.075 per 1M input tokens, $0.30 per 1M output tokens
#       Gemini 1.5 Pro - $1.25 per 1M input tokens, $5.00 per 1M output tokens
# Free tier: 15 requests/minute, 1 million tokens/minute, 1500 requests/day
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite  # Options: gemini-2.5-flash-lite, gemini-1.5-pro

# Application Configuration
LOG_LEVEL=INFO
CRAWLER_RATE_LIMIT=2
MAX_RETRIES=3
